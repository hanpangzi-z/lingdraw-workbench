AI_MOCK_MODE=false
SHOW_LAYOUT_DEBUG=false

# LingDraw internal identity and AI bridge. Use one long random token in both services.
PPT_INTERNAL_URL=http://127.0.0.1:37621
PPT_INTERNAL_TOKEN=replace-with-a-long-random-token

# Dedicated PostgreSQL database
PPT_DATABASE_URL=postgresql://lingdraw_ppt:change-me@127.0.0.1:5432/lingdraw_ppt?schema=public

# File storage: local | s3
STORAGE_PROVIDER=local
PPT_STORAGE_PATH=../data/ppt/storage
MAX_UPLOAD_MB=100
MAX_GENERATED_PPT_MB=300

# S3-compatible production storage (AWS S3 / R2 / MinIO)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
