# MySQL 8.0.45. Use distinct URL-safe passwords of at least 16 characters.
MYSQL_ROOT_PASSWORD=replace_with_unique_root_password
PLATFORM_MYSQL_PASSWORD=replace_with_unique_platform_password
DESIGN_AGENT_ENABLED=1
AGENT_ALLOWED_USERS=
AGENT_MYSQL_PASSWORD=replace-with-a-strong-database-password
TEMPORAL_MYSQL_PASSWORD=replace-with-a-different-strong-password
PLATFORM_DATABASE_URL=mysql+pymysql://platform:replace_with_unique_platform_password@127.0.0.1:3307/lingdraw_platform
AGENT_DATABASE_URL=mysql+asyncmy://agent:replace-with-a-strong-database-password@127.0.0.1:3307/lingdraw_agent
AGENT_AUTO_CREATE_SCHEMA=0
AGENT_ORCHESTRATOR=temporal
AGENT_INTERNAL_TOKEN=replace-with-a-long-random-token
AGENT_INTERNAL_API_URL=http://127.0.0.1:37621
AGENT_MAX_CONCURRENT_ACTIVITIES=8
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=lingdraw-design-agent

# PPT sidecar / MySQL 8.0 (keep the password and URL in sync)
PPT_MYSQL_PASSWORD=replace-with-a-third-strong-password
PPT_DATABASE_URL=mysql://folio:replace-with-a-third-strong-password@127.0.0.1:3307/folio
# Local isolated MySQL network. Other environments can configure a pinned RSA key.
PPT_MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
PPT_MYSQL_RSA_PUBLIC_KEY=
PPT_INTERNAL_URL=http://127.0.0.1:37623
PPT_INTERNAL_TOKEN=replace-with-another-long-random-token
PPT_STORAGE_PATH=data/ppt/storage
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
